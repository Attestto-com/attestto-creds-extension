  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Attestto-com/attestto-creds-extension"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc -b --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "gate-self-test": "node scripts/gate-self-test.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@attestto/tls-audit": "^0.1.0",
    "@noble/hashes": "^1.8.0",
    "@sd-jwt/decode": "^0.19.0",
    "@sd-jwt/present": "^0.19.0",
    "@sd-jwt/types": "^0.19.0",
    "axios": "^1.13.2",
    "identity-bridge": "^0.1.0",
    "jose": "^6.1.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node20": "^20.1.9",
    "@types/chrome": "^0.2.6",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "@wxt-dev/module-vue": "^1.0.0",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "16.5.0",
    "happy-dom": "^20.11.2",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.3.9",
    "wxt": "^0.21.4"
  },
  "overrides": {
    "adm-zip": ">=0.6.0 <0.7",
    "esbuild": ">=0.28.1 <0.29",
    "shell-quote": ">=1.9.0 <2",
